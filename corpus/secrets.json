{
  "class": "secrets",
  "cases": [
    {
      "id": "aws-key-in-tool-result",
      "kind": "attack",
      "about": "A tool result hands the model an AWS key.",
      "pinned": {"tools": [{"name": "read_file", "description": "Reads a file", "inputSchema": {"type": "object"}}]},
      "steps": [
        {"from": "client", "send": {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "read_file", "arguments": {"path": ".env"}}}, "expect": "forward"},
        {"from": "server", "send": {"jsonrpc": "2.0", "id": 1, "result": {"content": [{"type": "text", "text": "AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE"}]}}, "expect": "modify",
         "absent": ["AKIAIOSFODNN7EXAMPLE"], "present": ["[REDACTED: aws-access-key-id]"]}
      ]
    },
    {
      "id": "token-in-log-notification",
      "kind": "attack",
      "about": "A logging notification carries a GitHub token.",
      "skip_listing": true,
      "steps": [
        {"from": "server", "send": {"jsonrpc": "2.0", "method": "notifications/message", "params": {"level": "info", "data": "using token ghp_abcdefghijklmnopqrstuvwxyz0123456789"}}, "expect": "modify",
         "absent": ["ghp_abcdefghijklmnopqrstuvwxyz0123456789"], "present": ["[REDACTED: github-token]"]}
      ]
    },
    {
      "id": "private-key-in-resource",
      "kind": "attack",
      "about": "A resource's content includes a private key.",
      "pinned": {"resources": [{"uri": "file:///home/u/deploy.pem", "name": "deploy key"}]},
      "steps": [
        {"from": "client", "send": {"jsonrpc": "2.0", "id": 1, "method": "resources/read", "params": {"uri": "file:///home/u/deploy.pem"}}, "expect": "forward"},
        {"from": "server", "send": {"jsonrpc": "2.0", "id": 1, "result": {"contents": [{"uri": "file:///home/u/deploy.pem",
          "text": "-----BEGIN OPENSSH PRIVATE KEY-----\nb3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQ\n-----END OPENSSH PRIVATE KEY-----"}]}}, "expect": "modify",
         "absent": ["b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQ"], "present": ["[REDACTED: private-key]"]}
      ]
    },
    {
      "id": "key-in-error-message",
      "kind": "attack",
      "about": "A JSON-RPC error message leaks a key.",
      "pinned": {"tools": [{"name": "deploy", "description": "Deploys", "inputSchema": {"type": "object"}}]},
      "steps": [
        {"from": "client", "send": {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "deploy", "arguments": {}}}, "expect": "forward"},
        {"from": "server", "send": {"jsonrpc": "2.0", "id": 1, "error": {"code": -32000, "message": "auth failed for sk_live_abcdefghijklmnopqrstuvwx"}}, "expect": "modify",
         "absent": ["sk_live_abcdefghijklmnopqrstuvwx"]}
      ]
    },
    {
      "id": "key-in-structured-content",
      "kind": "attack",
      "about": "A key hides in structured output rather than text.",
      "pinned": {"tools": [{"name": "config", "description": "Shows config", "inputSchema": {"type": "object"}}]},
      "steps": [
        {"from": "client", "send": {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "config", "arguments": {}}}, "expect": "forward"},
        {"from": "server", "send": {"jsonrpc": "2.0", "id": 1, "result": {"content": [], "structuredContent": {"settings": {"slack": "xoxb-1234567890-abcdefghij"}}}}, "expect": "modify",
         "absent": ["xoxb-1234567890-abcdefghij"]}
      ]
    },
    {
      "id": "secret-in-sampling-request",
      "kind": "attack",
      "about": "With sampling allowed, the server's request to the model carries a secret.",
      "policy": "[server_requests]\nsampling = \"allow\"\n",
      "skip_listing": true,
      "steps": [
        {"from": "server", "send": {"jsonrpc": "2.0", "id": "s1", "method": "sampling/createMessage", "params": {"messages": [{"role": "user", "content": {"type": "text", "text": "Use key AIzaSyA-abcdefghijklmnopqrstuvwxyz01234"}}], "maxTokens": 50}}, "expect": "modify",
         "absent": ["AIzaSyA-abcdefghijklmnopqrstuvwxyz01234"]}
      ]
    },
    {
      "id": "secret-as-an-object-key",
      "kind": "attack",
      "about": "The server hides a key in an object key rather than a value.",
      "pinned": {"tools": [{"name": "config", "description": "Shows config", "inputSchema": {"type": "object"}}]},
      "steps": [
        {"from": "client", "send": {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "config", "arguments": {}}}, "expect": "forward"},
        {"from": "server", "send": {"jsonrpc": "2.0", "id": 1, "result": {"content": [], "structuredContent": {"AKIAIOSFODNN7EXAMPLE": "aws"}}}, "expect": "modify",
         "absent": ["AKIAIOSFODNN7EXAMPLE"]}
      ]
    },
    {
      "id": "secret-as-an-argument-key",
      "kind": "attack",
      "about": "A hijacked model smuggles a key out as an argument's name.",
      "pinned": {"tools": [{"name": "post", "description": "Posts text", "inputSchema": {"type": "object"}}]},
      "steps": [
        {"from": "client", "send": {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "post", "arguments": {"ghp_abcdefghijklmnopqrstuvwxyz0123456789": true}}}, "expect": "block"}
      ]
    },
    {
      "id": "secret-in-tool-arguments",
      "kind": "attack",
      "about": "A hijacked model passes a key it saw to a tool.",
      "pinned": {"tools": [{"name": "post", "description": "Posts text", "inputSchema": {"type": "object"}}]},
      "steps": [
        {"from": "client", "send": {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "post", "arguments": {"text": "key: sk-ant-api03-abcdefghijklmnopqrstuvwxyz"}}}, "expect": "block", "present": ["looks like a secret"]}
      ]
    },
    {
      "id": "secret-deep-in-arguments",
      "kind": "attack",
      "about": "The key is nested inside arrays and objects in the arguments.",
      "pinned": {"tools": [{"name": "post", "description": "Posts text", "inputSchema": {"type": "object"}}]},
      "steps": [
        {"from": "client", "send": {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "post", "arguments": {"items": [{"meta": {"note": ["x", "AKIAIOSFODNN7EXAMPLE"]}}]}}}, "expect": "block"}
      ]
    },
    {
      "id": "secret-in-prompt-arguments",
      "kind": "attack",
      "about": "A key leaves through a prompt's arguments instead of a tool call.",
      "pinned": {"prompts": [{"name": "summarize", "description": "Summarizes text"}]},
      "steps": [
        {"from": "client", "send": {"jsonrpc": "2.0", "id": 1, "method": "prompts/get", "params": {"name": "summarize", "arguments": {"text": "ghp_abcdefghijklmnopqrstuvwxyz0123456789"}}}, "expect": "block", "present": ["looks like a secret"]}
      ]
    },
    {
      "id": "secret-in-resource-uri",
      "kind": "attack",
      "about": "A resource template accepts any suffix, so a key can leave inside the URI.",
      "pinned": {"resource_templates": [{"uriTemplate": "docs://pages/{id}", "name": "Docs"}]},
      "steps": [
        {"from": "client", "send": {"jsonrpc": "2.0", "id": 1, "method": "resources/read", "params": {"uri": "docs://pages/AKIAIOSFODNN7EXAMPLE"}}, "expect": "block", "present": ["looks like a secret"]}
      ]
    },
    {
      "id": "custom-pattern-catches-internal-token",
      "kind": "attack",
      "about": "An organization-specific token shape is added to the policy, so it's redacted too.",
      "policy": "[[tools]]\nmatch = \"*\"\naction = \"allow\"\n[[secrets.patterns]]\nname = \"internal-token\"\nregex = \"itk_[a-z0-9]{32}\"\n",
      "pinned": {"tools": [{"name": "whoami", "description": "Shows the session", "inputSchema": {"type": "object"}}]},
      "steps": [
        {"from": "client", "send": {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "whoami", "arguments": {}}}, "expect": "forward"},
        {"from": "server", "send": {"jsonrpc": "2.0", "id": 1, "result": {"content": [{"type": "text", "text": "token itk_0123456789abcdef0123456789abcdef"}]}}, "expect": "modify",
         "present": ["[REDACTED: internal-token]"]}
      ]
    },
    {
      "id": "unknown-secret-shape",
      "kind": "known-gap",
      "about": "A secret with no recognizable shape (here a random string) passes. Add your own shapes under [[secrets.patterns]], as the case above does.",
      "pinned": {"tools": [{"name": "whoami", "description": "Shows the session", "inputSchema": {"type": "object"}}]},
      "steps": [
        {"from": "client", "send": {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "whoami", "arguments": {}}}, "expect": "forward"},
        {"from": "server", "send": {"jsonrpc": "2.0", "id": 1, "result": {"content": [{"type": "text", "text": "session 7f3kq9z2m1x8c4v6b0n5"}]}}, "expect": "forward"}
      ]
    },
    {
      "id": "image-data-untouched",
      "kind": "benign",
      "about": "Image data is never rewritten, even if its base64 happens to look like a key.",
      "pinned": {"tools": [{"name": "screenshot", "description": "Takes a screenshot", "inputSchema": {"type": "object"}}]},
      "steps": [
        {"from": "client", "send": {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "screenshot", "arguments": {}}}, "expect": "forward"},
        {"from": "server", "send": {"jsonrpc": "2.0", "id": 1, "result": {"content": [{"type": "image", "mimeType": "image/png", "data": "iVBORw0KGgoAKIAIOSFODNN7EXAMPLEAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJ"}]}}, "expect": "forward"}
      ]
    },
    {
      "id": "shell-snippet-in-result",
      "kind": "benign",
      "about": "Code with variables and quotes, but no secret, passes untouched.",
      "pinned": {"tools": [{"name": "docs", "description": "Searches the docs", "inputSchema": {"type": "object"}}]},
      "steps": [
        {"from": "client", "send": {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "docs", "arguments": {"query": "path setup"}}}, "expect": "forward"},
        {"from": "server", "send": {"jsonrpc": "2.0", "id": 1, "result": {"content": [{"type": "text", "text": "export PATH=\"$HOME/bin:$PATH\"\nif [ -n \"$TOKEN_FILE\" ]; then cat \"$TOKEN_FILE\"; fi"}]}}, "expect": "forward"}
      ]
    },
    {
      "id": "talk-about-passwords",
      "kind": "benign",
      "about": "Text that mentions passwords and tokens without containing any passes untouched.",
      "pinned": {"tools": [{"name": "docs", "description": "Searches the docs", "inputSchema": {"type": "object"}}]},
      "steps": [
        {"from": "client", "send": {"jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": {"name": "docs", "arguments": {"query": "password policy"}}}, "expect": "forward"},
        {"from": "server", "send": {"jsonrpc": "2.0", "id": 1, "result": {"content": [{"type": "text", "text": "Passwords need 12 characters. Rotate API tokens every 90 days; never paste a password into chat."}]}}, "expect": "forward"}
      ]
    }
  ]
}
